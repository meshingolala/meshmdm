# ==============================================================================
# Mesh MDM Environment Configuration
# ==============================================================================

# Public Domain Name
FLEET_SERVER_URL=https://mdm.meshtech.cloud

# Database Configuration
FLEET_MYSQL_ADDRESS=mysql:3306
FLEET_MYSQL_DATABASE=meshmdm
FLEET_MYSQL_USERNAME=meshmdm
FLEET_MYSQL_PASSWORD=meshmdmpassword
MYSQL_ROOT_PASSWORD=rootpassword

# Redis Configuration
FLEET_REDIS_ADDRESS=redis:6379

# Server Configuration
FLEET_SERVER_ADDRESS=0.0.0.0:8080
FLEET_SERVER_TLS=false
FLEET_DEV_LICENSE=true

# Cloudflare Tunnel Token (Get this from Cloudflare Zero Trust Dashboard -> Networks -> Tunnels)
# Paste your token here if using Cloudflare Tunnel:
CLOUDFLARE_TUNNEL_TOKEN=
